{
  "name": "neon-barrage",
  "version": "1.0.0",
  "private": true,
  "description": "Neon Barrage browser shoot-'em-up benchmark candidate",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "node --check public/app.js && node --check src/game-engine.js",
    "typecheck": "node --check public/app.js && node --check src/game-engine.js",
    "check": "npm run test && npm run lint && npm run build",
    "dev": "python3 -m http.server 4173 --directory ."
  },
  "devDependencies": {
    "wrangler": "4.47.0"
  },
  "engines": {
    "node": ">=22"
  }
}
